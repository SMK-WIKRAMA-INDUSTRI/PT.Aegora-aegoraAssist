APP_NAME="Aegora Assist"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# KONFIGURASI DATABASE MYSQL (XAMPP / PRODUCTION)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aegora_assist
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="cs@aegora.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# KONFIGURASI AI CS AGENT: NETRA RUNTIME & MODEL DEEPSEEK
# ==============================================================================
# 1. Masukkan API Key Netra Runtime Anda di sini:
NETRA_API_KEY=

# 2. Endpoint Provider Netra Runtime:
#    Default: https://api.netraruntime.com/v1 (atau https://api.netra.ai/v1)
NETRA_API_URL=https://api.netraruntime.com/v1

# 3. Model DeepSeek di Netra Runtime:
#    Model resmi Netra: deepseek/deepseek-v4.1-flash, deepseek/deepseek-v4.1-flash:agents
NETRA_MODEL=deepseek/deepseek-v4.1-flash

# 4. Pengaturan Timeout & Parameter (Opsional):
NETRA_TIMEOUT=30
NETRA_TEMPERATURE=0.7
NETRA_MAX_TOKENS=1500

# ==============================================================================
# KONFIGURASI VOICE / TTS & STT (STS): DEEPGRAM
# ==============================================================================
# 1. Masukkan API Key Deepgram Anda di sini (https://console.deepgram.com/):
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com

# 2. Model Speech-to-Text (Nova-3 dengan auto-detect bahasa):
DEEPGRAM_STT_MODEL=nova-3

# 3. Karakter Suara Customer Service Hotel (Sopan, Ramah, & Berwibawa):
#    Indonesia (Flux TTS): flux-fitri-id, flux-dewi-id, flux-teguh-id, flux-fajar-id, flux-rizky-id
#    English (Aura-2): aura-2-helena-en, aura-2-thalia-en, aura-2-cordelia-en, aura-2-apollo-en
DEEPGRAM_TTS_ID_VOICE=flux-fitri-id
DEEPGRAM_TTS_EN_VOICE=aura-2-helena-en
DEEPGRAM_TTS_SPEED=1.0
DEEPGRAM_TTS_EXPRESSIVITY=0

VITE_APP_NAME="${APP_NAME}"
